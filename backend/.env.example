# Application
APP_NAME=docIS

# Used when running the app on the host (task dev, alembic, tests).
DATABASE_URL=postgresql+asyncpg://docis:docis@localhost:5434/docis

# Document uploads
STORAGE_DIR=storage
# Per-file size limit in MB (fractions allowed, e.g. 0.5) and the maximum
# number of files in one upload request.
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=20

# Rate limiting per client IP. Requests per minute for everything except
# /health, and a smaller limit for uploads and retries (they start OCR and
# paid AI calls). Behind reverse proxies, set how many append to
# X-Forwarded-For (0 = use the connecting address).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PROCESSING_PER_MINUTE=20
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Docker Compose (compose.yaml builds DATABASE_URL for containers from these)
POSTGRES_USER=docis
POSTGRES_PASSWORD=docis
POSTGRES_DB=docis
POSTGRES_PORT=5434
API_PORT=8000

# OCR (Tesseract). Languages must be installed; e.g. eng+deu.
# For Docker, also build them in: OCR_EXTRA_LANGS="deu"
OCR_EXTRA_LANGS=
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=120

# Background processing (Celery + Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2
JOB_RECOVERY_INTERVAL_SECONDS=60
JOB_REDISPATCH_AFTER_SECONDS=600
JOB_LEASE_SECONDS=300
PROGRESS_INTERVAL_SECONDS=1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=900

# Search (semantic search embeds locally with bge-small-en-v1.5; the model
# downloads once into EMBEDDING_CACHE_DIR, or is baked into the Docker image)
SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_CACHE_DIR=
SEMANTIC_MIN_SCORE=0.5

# Docker Compose: Redis port on the host (for task worker/beat)
REDIS_PORT=6379

# AI invoice extraction (Claude)
ANTHROPIC_API_KEY=
INVOICE_EXTRACTION_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=32000
LLM_TIMEOUT_SECONDS=600
# Long documents are extracted in parts of about LLM_CHUNK_CHARS characters
# (split between pages/sheets), LLM_PART_CONCURRENCY at a time, then merged.
# More than LLM_MAX_PARTS parts fails the job (a cost guard).
LLM_CHUNK_CHARS=50000
LLM_MAX_PARTS=120
LLM_PART_CONCURRENCY=4
VALIDATION_TOLERANCE=0.01
REVIEW_MIN_OCR_CONFIDENCE=80
