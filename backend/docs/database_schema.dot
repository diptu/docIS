digraph ER {
graph [rankdir=LR, fontname="Helvetica", fontsize=24, labelloc=t, label=<<b>docIS — Entity Relationship Diagram</b>>, pad=0.4, nodesep=0.35, ranksep=1.2, bgcolor=white];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=11, color="#4a5b75", fontcolor="#33415c", arrowhead=crow, arrowtail=tee, dir=both];
documents [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> documents </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>file_name</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(255) · NOT NULL</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>file_type</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(100) · NOT NULL</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>storage_path</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(1024) · NOT NULL</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>size_bytes</b></font></td><td align="left"><font point-size="10" color="#4a5568">bigint</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>sha256</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(64) · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>status</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(50) · NOT NULL · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at / updated_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz · NOT NULL</font></td></tr></table>>];
document_pages [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> document_pages </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>page_number</b></font></td><td align="left"><font point-size="10" color="#4a5568">int · unique per document</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>text</b></font></td><td align="left"><font point-size="10" color="#4a5568">text · NOT NULL</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>char_count</b></font></td><td align="left"><font point-size="10" color="#4a5568">int</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>extraction_method</b></font></td><td align="left"><font point-size="10" color="#4a5568">text_layer | ocr</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>needs_ocr</b></font></td><td align="left"><font point-size="10" color="#4a5568">boolean · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>ocr_confidence</b></font></td><td align="left"><font point-size="10" color="#4a5568">float 0–100</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at / updated_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
document_sheets [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> document_sheets </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>sheet_number</b></font></td><td align="left"><font point-size="10" color="#4a5568">int · unique per document</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>name</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(255)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>row_count / column_count</b></font></td><td align="left"><font point-size="10" color="#4a5568">int</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>rows</b></font></td><td align="left"><font point-size="10" color="#4a5568">jsonb · cell grid</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>is_hidden / truncated</b></font></td><td align="left"><font point-size="10" color="#4a5568">boolean</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at / updated_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
document_chunks [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> document_chunks </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>chunk_index</b></font></td><td align="left"><font point-size="10" color="#4a5568">int · unique per document</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>page_number</b></font></td><td align="left"><font point-size="10" color="#4a5568">int · source page</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>sheet_number / sheet_name</b></font></td><td align="left"><font point-size="10" color="#4a5568">source sheet</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>content</b></font></td><td align="left"><font point-size="10" color="#4a5568">text · GIN full-text index</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>embedding</b></font></td><td align="left"><font point-size="10" color="#4a5568">vector(384) · HNSW cosine</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at / updated_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
processing_jobs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> processing_jobs </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>kind</b></font></td><td align="left"><font point-size="10" color="#4a5568">extract_content | extract_invoice</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>status</b></font></td><td align="left"><font point-size="10" color="#4a5568">queued | running | succeeded | failed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>stage</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(50)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>progress_current / _total</b></font></td><td align="left"><font point-size="10" color="#4a5568">int</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>attempts / max_attempts</b></font></td><td align="left"><font point-size="10" color="#4a5568">int · default 3</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>next_run_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz · retry backoff</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>error</b></font></td><td align="left"><font point-size="10" color="#4a5568">text</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>worker_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(100)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>started_at / heartbeat_at / finished_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz · lease</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at / updated_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
invoices [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> invoices </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · UNIQUE · CASCADE</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>is_invoice</b></font></td><td align="left"><font point-size="10" color="#4a5568">boolean</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>invoice_number</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(100) · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>invoice_date / due_date</b></font></td><td align="left"><font point-size="10" color="#4a5568">date</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>currency</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(10)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>purchase_order_number / payment_terms</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>vendor_name (+ address, tax_id, email, phone)</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>customer_name (+ address, tax_id, email, phone)</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>subtotal / tax / total_amount / amount_due</b></font></td><td align="left"><font point-size="10" color="#4a5568">numeric(18,4)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>uncertain_fields</b></font></td><td align="left"><font point-size="10" color="#4a5568">jsonb</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>invoice_number_key / vendor_key</b></font></td><td align="left"><font point-size="10" color="#4a5568">duplicate lookup · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>model / input_tokens / output_tokens / cache_read_tokens</b></font></td><td align="left"><font point-size="10" color="#4a5568">LLM usage</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at / updated_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
invoice_line_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> invoice_line_items </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>invoice_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>line_number</b></font></td><td align="left"><font point-size="10" color="#4a5568">int · unique per invoice</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>description</b></font></td><td align="left"><font point-size="10" color="#4a5568">text</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>product_code</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(100)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>quantity / unit_price / amount</b></font></td><td align="left"><font point-size="10" color="#4a5568">numeric(18,4)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>unit</b></font></td><td align="left"><font point-size="10" color="#4a5568">varchar(50)</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>tax_rate</b></font></td><td align="left"><font point-size="10" color="#4a5568">numeric(7,4) · percent</font></td></tr></table>>];
validation_errors [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> validation_errors </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>code</b></font></td><td align="left"><font point-size="10" color="#4a5568">total, duplicate, missing_fields, …</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>severity</b></font></td><td align="left"><font point-size="10" color="#4a5568">error | warning</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>message</b></font></td><td align="left"><font point-size="10" color="#4a5568">text</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>details</b></font></td><td align="left"><font point-size="10" color="#4a5568">jsonb</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>resolved / resolved_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">boolean / timestamptz</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
invoice_corrections [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9aa8bd"><tr><td colspan="3" bgcolor="#1f3b63" align="left"><font color="white" point-size="14"><b> invoice_corrections </b></font></td></tr><tr><td bgcolor="#e3eaf4"><font point-size="10"><b>KEY</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>FIELD</b></font></td><td bgcolor="#e3eaf4" align="left"><font point-size="10"><b>TYPE / NOTES</b></font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>PK</b></font></td><td align="left" port="id"><font point-size="11"><b>id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid</font></td></tr><tr><td bgcolor="#eef3fa"><font color="#1f5fbf"><b>FK</b></font></td><td align="left"><font point-size="11"><b>document_id</b></font></td><td align="left"><font point-size="10" color="#4a5568">uuid · CASCADE · indexed</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>changes</b></font></td><td align="left"><font point-size="10" color="#4a5568">jsonb · {field: {old, new}}</font></td></tr><tr><td bgcolor="white"></td><td align="left"><font point-size="11"><b>created_at</b></font></td><td align="left"><font point-size="10" color="#4a5568">timestamptz</font></td></tr></table>>];
documents -> document_pages [label="has pages  1 : N"];
documents -> document_sheets [label="has sheets  1 : N"];
documents -> document_chunks [label="indexed as  1 : N"];
documents -> processing_jobs [label="processed by  1 : N"];
documents -> validation_errors [label="has problems  1 : N"];
documents -> invoice_corrections [label="corrected by  1 : N"];
documents -> invoices [label="extracted as  1 : 0..1", arrowhead=teeodot];
invoices -> invoice_line_items [label="has lines  1 : N"];
}