# docIS settings for deploy/docker-compose.yml.
# Copy to .env next to docker-compose.yml and paste your API key below.
# That is the only setting you need: PostgreSQL + pgvector, Redis and the
# database tables are set up automatically. Everything under "Optional" has
# a working default. After changing anything: docker compose up -d

# --- Required ---------------------------------------------------------------

# Claude API key for AI invoice extraction (https://console.anthropic.com).
# Without it, uploads are still stored, OCR'd and searchable, but invoice
# extraction jobs fail with a clear message.
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------

# Database login. The database is only reachable inside Docker's private
# network for this app, so the defaults are safe for a single server. To
# use your own, set these before the first start: changing them later needs
# the database reset (docker compose down -v deletes all documents).
# POSTGRES_PASSWORD=docis
# POSTGRES_USER=docis
# POSTGRES_DB=docis

# Image version from https://hub.docker.com/r/diptu/docis/tags
# (latest, or a fixed version such as 0.1.0).
DOCIS_VERSION=latest

# Ports on this machine. The web app is what users open.
WEB_PORT=8080
# The API is only reachable from this machine (127.0.0.1); Swagger UI at /docs.
API_PORT=8000

# Uploads: per-file limit in MB and files per upload. Keep
# WEB_MAX_UPLOAD_SIZE >= MAX_FILES_PER_UPLOAD x MAX_UPLOAD_SIZE_MB.
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=20
WEB_MAX_UPLOAD_SIZE=1100m

# AI extraction
INVOICE_EXTRACTION_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Background processing: parallel jobs per worker container.
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3

# OCR language (the image includes English).
OCR_LANGUAGES=eng

# Rate limits per client IP (requests per minute).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PROCESSING_PER_MINUTE=20

# Flags for manual review when OCR confidence is below this (0-100).
REVIEW_MIN_OCR_CONFIDENCE=80
